<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Gestion des commandes</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; background: #f4f6f8; }
        nav { background: #2c3e50; padding: 12px 24px; }
        nav a { color: white; margin-right: 24px; text-decoration: none; font-weight: bold; }
        nav a:hover { text-decoration: underline; }
        .container { max-width: 950px; margin: 24px auto; background: white; padding: 24px; border-radius: 8px; }
        table { width: 100%; border-collapse: collapse; margin-top: 16px; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        th { background: #34495e; color: white; }
        input, select { padding: 6px; margin: 4px 0; width: 300px; }
        .btn { padding: 6px 12px; background: #2980b9; color: white; border: none; border-radius: 4px; text-decoration: none; cursor: pointer; }
        .btn-danger { background: #c0392b; }
        .btn-ok { background: #27ae60; }
    </style>
</head>
<body>
<nav>
    <a href="${pageContext.request.contextPath}/">Accueil</a>
    <a href="${pageContext.request.contextPath}/clients">Clients</a>
    <a href="${pageContext.request.contextPath}/produits">Produits</a>
    <a href="${pageContext.request.contextPath}/commandes">Commandes</a>
</nav>
<div class="container">